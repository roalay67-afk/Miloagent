    f.o.position.addScaledVector(f.v,dt);f.v.multiplyScalar(Math.exp(-f.dr*dt));f.v.y+=(f.b-f.g)*dt;
    f.o.scale.setScalar(f.s0+(f.s1-f.s0)*Math.sqrt(u));f.m.rotation+=f.rot*dt;
    if(f.type=='smoke'){const c=.1+.32*u;f.m.color.setRGB(c,c,c*.97);f.m.opacity=f.a0*Math.min(1,u*8)*Math.pow(1-u,1.3)}
