function merge(gs){
  let vc=0;for(const g of gs)vc+=g.attributes.position.count;
  const P=new Float32Array(vc*3),N=new Float32Array(vc*3),U=new Float32Array(vc*2),C=new Float32Array(vc*3),I=[];
  let o=0;
  for(const g of gs){const a=g.attributes,n=a.position.count,c=g.userData.c;
    P.set(a.position.array,o*3);N.set(a.normal.array,o*3);U.set(a.uv.array,o*2);
    for(let i=0;i<n;i++){C[(o+i)*3]=c.r;C[(o+i)*3+1]=c.g;C[(o+i)*3+2]=c.b}
    for(const i of g.index.array)I.push(i+o);
    o+=n;g.dispose()}
  const m=new T.BufferGeometry();
  m.setAttribute('position',new T.BufferAttribute(P,3));
  m.setAttribute('normal',new T.BufferAttribute(N,3));
  m.setAttribute('uv',new T.BufferAttribute(U,2));
  m.setAttribute('color',new T.BufferAttribute(C,3));
  m.setIndex(I);return m;
}
