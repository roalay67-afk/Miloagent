      <button class="b" style="margin-top:8px" onclick="buyUpgrade('hull')">🛡️ Корпус (+1 HP)</button>
      <button class="b" style="margin-top:8px" onclick="buyUpgrade('scanner')">📡 Сканер</button>
    </div>
  </div>`);
}
function settingsScreen(){
  const s=localStorage.getItem('sens')||5;
  showMenu(`<div class="screen">
    <button class="back" onclick="homeScreen()">← Назад</button>
    <h1 class="sectionTitle">⚙ Настройки</h1>
    <div class="panel">
      <h2>Чувствительность: <span id="sensVal">${s}</span></h2>
