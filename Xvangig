<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#0d1218">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Drone War Beta 2.0</title>
<style>
:root{--bg:#0d1218;--fg:#fff;--ac:#ff4d3d;--ok:#3ddc84;--warn:#ffb020}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:var(--bg);color:var(--fg);font-family:-apple-system,Segoe UI,Roboto,sans-serif;overflow:hidden;touch-action:none;-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent}
canvas#gl{display:block;position:fixed;inset:0}
#hud{position:fixed;top:0;left:0;right:0;padding:calc(env(safe-area-inset-top,0px) + 10px) 14px 0;display:flex;justify-content:space-between;font-weight:700;font-size:16px;pointer-events:none;text-shadow:0 1px 4px #000;z-index:10}
#warn{position:fixed;top:22%;left:0;right:0;text-align:center;font-size:24px;font-weight:900;color:var(--ac);text-shadow:0 2px 8px #000;pointer-events:none;z-index:10;opacity:0;transition:opacity .15s}
#warn.show{opacity:1;animation:pulse .5s infinite alternate}
@keyframes pulse{from{transform:scale(1)}to{transform:scale(1.08)}}
#fl{position:fixed;inset:0;background:radial-gradient(circle,transparent 40%,#f33 100%);opacity:0;pointer-events:none;transition:opacity .3s;z-index:5}
#js{position:fixed;left:calc(env(safe-area-inset-left,0px) + 22px);bottom:calc(env(safe-area-inset-bottom,0px) + 26px);width:130px;height:130px;border-radius:50%;background:rgba(255,255,255,.14);border:2px solid rgba(255,255,255,.4);display:none;pointer-events:none;opacity:.35;z-index:8}
#kn{position:absolute;left:40px;top:40px;width:50px;height:50px;border-radius:50%;background:rgba(255,255,255,.65);pointer-events:none}
#minimap{position:fixed;top:calc(env(safe-area-inset-top,0px) + 50px);right:14px;width:110px;height:110px;border-radius:12px;background:rgba(10,15,22,.75);border:1px solid rgba(255,255,255,.25);z-index:9;pointer-events:none}
#targetArrow{position:fixed;width:0;height:0;border-left:10px solid transparent;border-right:10px solid transparent;border-bottom:18px solid var(--ac);pointer-events:none;z-index:9;transition:opacity .2s;filter:drop-shadow(0 0 4px #000);opacity:0}
#consumables{position:fixed;right:14px;bottom:calc(env(safe-area-inset-bottom,0px) + 26px);display:flex;flex-direction:column;gap:8px;z-index:9}
.cbtn{width:52px;height:52px;border-radius:50%;background:rgba(30,40,52,.85);border:2px solid #4a5a6a;color:#fff;font-size:20px;display:flex;align-items:center;justify-content:center;position:relative;cursor:pointer;user-select:none;transition:transform .1s}
.cbtn:active{transform:scale(.92);background:rgba(60,80,100,.9)}
.cbtn .cnt{position:absolute;top:-4px;right:-4px;background:var(--ac);border-radius:50%;font-size:11px;padding:2px 6px;font-weight:900;min-width:18px;text-align:center}
.cbtn.empty{opacity:.35}
#msg{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;text-align:center;background:rgba(5,8,12,.92);padding:calc(env(safe-area-inset-top,0px) + 22px) 16px calc(env(safe-area-inset-bottom,0px) + 22px);overflow-y:auto;z-index:20;overscroll-behavior:contain}
#msg h1{margin:0 0 8px;font-size:28px}
#msg p{margin:4px 0 14px;opacity:.9;line-height:1.4;max-width:330px}
.b{background:var(--ac);color:#fff;border:0;border-radius:14px;font-size:17px;font-weight:700;padding:13px 28px;margin:5px;cursor:pointer;transition:transform .1s}
.b:active{transform:scale(.97)}
.m{background:#26303b;color:#fff;border:2px solid transparent;border-radius:12px;padding:10px 14px;margin:4px;font-size:15px;font-weight:600;cursor:pointer;transition:transform .1s}
.m:active{transform:scale(.97)}
.m.s{border-color:var(--ok)}
.mm{display:flex;flex-direction:column;width:240px}.mm .b,.mm .m{margin:5px 0;width:100%}.mm small{opacity:.55;font-weight:400;margin-left:6px}
#msg .screen{width:min(100%,440px);margin:auto;display:flex;flex-direction:column;align-items:stretch;gap:12px;text-align:left}
#msg .brand{font-size:clamp(27px,7vw,36px);font-weight:950;letter-spacing:-1.2px;line-height:1.02;margin:0}
#msg .sub{color:#b9c5d2;font-size:13px;line-height:1.45;margin:0}
#msg .topline{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
#msg .wallet{display:flex;align-items:center;gap:7px;background:linear-gradient(135deg,#263744,#17232d);border:1px solid #49616b;border-radius:14px;padding:10px 12px;font-weight:800;white-space:nowrap}
#msg .wallet b{color:#ffd36a}
#msg .eyebrow{font-size:11px;letter-spacing:1.7px;color:#ff8c76;font-weight:900;text-transform:uppercase}
#msg .panel{background:linear-gradient(145deg,rgba(31,43,55,.96),rgba(15,22,30,.96));border:1px solid #354656;border-radius:18px;padding:15px;box-shadow:0 12px 32px #0003}
#msg .panel h2{font-size:17px;margin:0 0 7px}
#msg .panel p{font-size:13px;color:#c4cfda;margin:0;max-width:none}
#msg .grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
#msg .tile{background:#1b2631;border:1px solid #334352;border-radius:15px;padding:13px;text-align:left;color:#fff;min-width:0;cursor:pointer;transition:transform .1s}
#msg .tile:active{transform:scale(.98)}
#msg .tile strong{display:block;font-size:15px;margin-bottom:5px}
#msg .tile small{display:block;color:#aab9c8;font-size:12px;line-height:1.35}
#msg .tile .emoji{font-size:24px;display:block;margin-bottom:7px}
#msg .tile.active{border-color:#ff745f;background:#332a2c}
#msg .tile.locked{opacity:.8}
#msg .bar{height:6px;background:#34414c;border-radius:9px;overflow:hidden;margin-top:9px}
#msg .bar i{height:100%;display:block;background:linear-gradient(90deg,#ff4d3d,#ffbd65);border-radius:9px}
#msg .actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}
#msg button{font-family:inherit;cursor:pointer}
#msg .b{width:100%;margin:0;padding:14px 16px;background:linear-gradient(135deg,#ff634d,#e83c31);box-shadow:0 6px 20px #e83c3130}
#msg .m{margin:0;width:100%;background:#202d38;border-color:#334554;padding:12px 10px}
#msg .back{background:transparent;border:0;color:#b8c7d5;text-align:left;padding:5px 0;font-size:14px}
#msg .sectionTitle{font-size:20px;font-weight:900;margin:0}
#msg .price{font-weight:900;color:#ffd36a}
#msg .statrow{display:flex;justify-content:space-between;gap:12px;font-size:13px;padding:5px 0;color:#c6d1dc}
#msg .statrow b{color:#fff}
#msg .notice{font-size:12px;color:#a9bac8;line-height:1.4}
#msg .maprow{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}
#msg .maprow .m{font-size:12px;padding:12px 5px}
#msg .foot{color:#758796;font-size:11px;text-align:center}
#msg input[type=range]{width:100%;accent-color:var(--ac)}
#msg input[type=checkbox]{accent-color:var(--ac);transform:scale(1.2);margin-right:6px}
#toast{position:fixed;top:14%;left:50%;transform:translateX(-50%);background:rgba(30,40,52,.95);border:1px solid #4a5a6a;border-radius:12px;padding:10px 18px;font-weight:700;z-index:30;opacity:0;transition:opacity .3s;pointer-events:none;white-space:nowrap;max-width:90vw}
#toast.show{opacity:1}
#loading{position:fixed;inset:0;background:#0d1218;display:flex;align-items:center;justify-content:center;flex-direction:column;z-index:100;color:#fff}
#loading .sp{width:50px;height:50px;border:4px solid #334454;border-top-color:var(--ac);border-radius:50%;animation:spin 1s linear infinite;margin-bottom:16px}
@keyframes spin{to{transform:rotate(360deg)}}
</style>
</head>
<body>
<div id="loading"><div class="sp"></div><div>Загрузка...</div></div>
<div id="hud"><span id="lv"></span><span id="dist"></span><span id="hp"></span></div>
<div id="warn">⚠ УГРОЗА</div>
<div id="fl"></div>
<div id="js"><div id="kn"></div></div>
<canvas id="minimap" width="220" height="220"></canvas>
<div id="targetArrow"></div>
<div id="consumables">
  <div class="cbtn" id="btnFlare" title="Ловушки">🔥<span class="cnt">3</span></div>
  <div class="cbtn" id="btnBoost" title="Ускорение">⚡<span class="cnt">2</span></div>
  <div class="cbtn" id="btnRepair" title="Ремонт">🛠<span class="cnt">1</span></div>
</div>
<div id="msg"></div>
<div id="toast"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
'use strict';
// ═══════════════════════════════════════════════════════════════
// БАЗА
// ═══════════════════════════════════════════════════════════════
const $=i=>document.getElementById(i),T=THREE,rnd=Math.random;
const R=new T.WebGLRenderer({antialias:true,powerPreference:'high-performance',canvas:undefined});
R.setPixelRatio(Math.min(devicePixelRatio||1,1.75));
R.toneMapping=T.ACESFilmicToneMapping;R.toneMappingExposure=1.2;
R.shadowMap.enabled=true;R.shadowMap.type=T.PCFSoftShadowMap;
R.domElement.id='gl';document.body.insertBefore(R.domElement,document.body.firstChild);
const sc=new T.Scene(),cam=new T.PerspectiveCamera(68,1,.5,900);
function rs(){R.setSize(innerWidth,innerHeight);cam.aspect=innerWidth/innerHeight;cam.updateProjectionMatrix()}rs();addEventListener('resize',rs);

// ═══════════════════════════════════════════════════════════════
// ЗВУК (WebAudio синтез)
// ═══════════════════════════════════════════════════════════════
let AC=null,soundEnabled=true,musicEnabled=false;
function ensureAudio(){if(!AC){try{AC=new (window.AudioContext||window.webkitAudioContext)()}catch(e){return null}}if(AC.state==='suspended')AC.resume();return AC}
function sndBoom(vol=1){
  if(!soundEnabled)return;const a=ensureAudio();if(!a)return;
  const t=a.currentTime,buf=a.createBuffer(1,a.sampleRate*0.8,a.sampleRate),d=buf.getChannelData(0);
  for(let i=0;i<d.length;i++){const k=1-i/d.length;d[i]=(Math.random()*2-1)*Math.pow(k,2.2)}
  const s=a.createBufferSource();s.buffer=buf;
  const f=a.createBiquadFilter();f.type='lowpass';f.frequency.setValueAtTime(1200,t);f.frequency.exponentialRampToValueAtTime(120,t+.6);
  const g=a.createGain();g.gain.setValueAtTime(0.6*vol,t);g.gain.exponentialRampToValueAtTime(0.001,t+.8);
  s.connect(f);f.connect(g);g.connect(a.destination);s.start(t);s.stop(t+.85);
}
function sndRWR(){
  if(!soundEnabled)return;const a=ensureAudio();if(!a)return;const t=a.currentTime;
  for(let i=0;i<4;i++){const o=a.createOscillator(),g=a.createGain();
    o.type='square';o.frequency.value=i%2?1100:1500;
    g.gain.setValueAtTime(0,t+i*.09);g.gain.linearRampToValueAtTime(.06,t+i*.09+.01);
    g.gain.exponentialRampToValueAtTime(.001,t+i*.09+.07);
    o.connect(g);g.connect(a.destination);o.start(t+i*.09);o.stop(t+i*.09+.08)}
}
function sndPickup(){
  if(!soundEnabled)return;const a=ensureAudio();if(!a)return;const t=a.currentTime;
  const o=a.createOscillator(),g=a.createGain();o.type='sine';o.frequency.setValueAtTime(880,t);o.frequency.exponentialRampToValueAtTime(1320,t+.15);
  g.gain.setValueAtTime(.08,t);g.gain.exponentialRampToValueAtTime(.001,t+.2);
  o.connect(g);g.connect(a.destination);o.start(t);o.stop(t+.2);
}

// ═══════════════════════════════════════════════════════════════
// МИР
// ═══════════════════════════════════════════════════════════════
const hemi=new T.HemisphereLight(0xffffff,0x555566,.8),sun=new T.DirectionalLight(0xffffff,1);
sun.position.set(-40,80,30);sun.castShadow=true;sun.shadow.mapSize.set(1024,1024);
{const q=sun.shadow.camera;q.left=q.bottom=-130;q.right=q.top=130;q.near=10;q.far=500}
sun.shadow.bias=-.0006;sc.add(hemi,sun,sun.target);

const M=(c,e)=>new T.MeshStandardMaterial({color:c,emissive:e||0,roughness:.75,metalness:.15}),
      MS=(c,o)=>new T.MeshStandardMaterial(Object.assign({color:c,roughness:.9,metalness:0,flatShading:true},o)),
      B=c=>new T.MeshBasicMaterial({color:c});
const BOX=new T.BoxGeometry(1,1,1),CYL=new T.CylinderGeometry(1,1,1,12),CONE=new T.ConeGeometry(1,1,8),SPH=new T.SphereGeometry(1,6,6);
const RD=M(0x9a3b2c),CONC=MS(0xb8bcc2,{flatShading:false,roughness:.6}),SNOW=MS(0xf4f8ff,{flatShading:false,roughness:.8});
const ROCK=new T.IcosahedronGeometry(1,1);
{const a=ROCK.attributes.position;for(let i=0;i<a.count;i++){const X=a.getX(i),Y=a.getY(i),Z=a.getZ(i),k=.85+.2*Math.sin(X*7+Y*5)*Math.cos(Z*6);a.setXYZ(i,X*k,Y*k,Z*k)}ROCK.computeVertexNormals()}

// Полосатая текстура
const stc=document.createElement('canvas');stc.width=8;stc.height=64;
{const x=stc.getContext('2d');for(let i=0;i<8;i++){x.fillStyle=i%2?'#d9d9d9':'#c8321f';x.fillRect(0,i*8,8,8)}}
const stT=new T.CanvasTexture(stc);stT.wrapS=stT.wrapT=T.RepeatWrapping;stT.repeat.set(1,2);
const STRIPE=M(0xffffff);STRIPE.map=stT;

// Панельная текстура для моделей
const pc=document.createElement('canvas');pc.width=pc.height=128;
{const x=pc.getContext('2d');x.fillStyle='#e8eaed';x.fillRect(0,0,128,128);
 for(let i=0;i<30;i++){const v=200+rnd()*40|0;x.fillStyle='rgba('+v+','+v+','+v+',.5)';x.fillRect(rnd()*128,rnd()*128,20+rnd()*40,10+rnd()*20)}
 x.strokeStyle='rgba(40,45,55,.55)';x.lineWidth=1.5;
 for(let i=0;i<=128;i+=32){x.beginPath();x.moveTo(i,0);x.lineTo(i,128);x.moveTo(0,i);x.lineTo(128,i);x.stroke()}
 x.fillStyle='rgba(30,30,35,.6)';for(let i=0;i<128;i+=8)for(const l of[0,32,64,96])x.fillRect(i,l+3,1.5,1.5)}
const PANEL=new T.CanvasTexture(pc);PANEL.wrapS=PANEL.wrapT=T.RepeatWrapping;PANEL.anisotropy=4;

// Фасады зданий
let FAC=null;
function facade(night){
  const S=256,c=document.createElement('canvas'),e=document.createElement('canvas');c.width=c.height=e.width=e.height=S;
  const x=c.getContext('2d'),y=e.getContext('2d');
  x.fillStyle='#8d9096';x.fillRect(0,0,S,S);
  for(let i=0;i<1200;i++){const v=110+rnd()*70|0;x.fillStyle='rgba('+v+','+v+','+v+',.25)';x.fillRect(rnd()*S,rnd()*S,3,3)}
  y.fillStyle='#000';y.fillRect(0,0,S,S);
  for(let i=0;i<4;i++)for(let k=0;k<4;k++){
    const px=i*64+9,py=k*64+12,w=46,h=38;
    const g=x.createLinearGradient(0,py,0,py+h);g.addColorStop(0,night?'#2a3a52':'#6d90b4');g.addColorStop(1,night?'#10182a':'#22344a');
    x.fillStyle=g;x.fillRect(px,py,w,h);x.fillStyle='rgba(255,255,255,.2)';x.fillRect(px,py,w,5);
    x.fillStyle='#62656b';x.fillRect(px-2,py+h,w+4,3);
    if(night&&rnd()<.45){y.fillStyle=rnd()<.8?'#ffd48a':'#9fd0ff';y.fillRect(px,py,w,h)}}
  const mk=q=>{const t=new T.CanvasTexture(q);t.wrapS=t.wrapT=T.RepeatWrapping;t.anisotropy=4;return t};
  return{map:mk(c),em:mk(e)};
}
function bmat(w,h){
  const m=new T.MeshStandardMaterial({map:FAC.map.clone(),roughness:.75,metalness:.15});
  m.map.repeat.set(Math.max(1,w/14),Math.max(1,h/14));m.map.needsUpdate=true;
  if(map.d=='city'){m.emissive.set(0xffffff);m.emissiveMap=FAC.em.clone();m.emissiveMap.repeat.copy(m.map.repeat);m.emissiveMap.needsUpdate=true}
  return m;
}
function mesh(g,m,sx,sy,sz,x,y,z){
  const o=new T.Mesh(g,m===WALL?(g===BOX?bmat(Math.max(sx,sz),sy):CONC):(m===RD&&g===CYL)?STRIPE:m);
  o.castShadow=o.receiveShadow=true;o.scale.set(sx,sy,sz);o.position.set(x,y,z);return o;
}

// Земля
function groundTex(d){
  const N=512,c=document.createElement('canvas');c.width=c.height=N;
  const x=c.getContext('2d'),B0={rock:[198,158,98],pine:[232,239,246],city:[74,78,88]}[d],a=d=='pine'?20:36;
  x.fillStyle='rgb('+B0+')';x.fillRect(0,0,N,N);
  for(let i=0;i<2400;i++){
    const r=5+rnd()*30,px=rnd()*N,py=rnd()*N,v=(rnd()-.5)*a;
    x.fillStyle='rgba('+(B0[0]+v|0)+','+(B0[1]+v|0)+','+(B0[2]+v*(d=='pine'?-.4:.8)|0)+',.2)';
    for(const ox of[0,-N])for(const oy of[0,-N]){x.beginPath();x.arc(px+ox,py+oy,r,0,7);x.fill()}}
  if(d=='rock'){x.strokeStyle='rgba(120,85,45,.18)';x.lineWidth=2;for(let i=0;i<40;i++){const y0=rnd()*N,ph=rnd()*6;x.beginPath();for(let k=0;k<=N;k+=8)x.lineTo(k,y0+Math.sin(k/40+ph)*6);x.stroke()}}
  if(d=='city'){x.fillStyle='#262a32';x.fillRect(0,236,N,40);x.fillRect(236,0,40,N);x.fillStyle='rgba(255,255,255,.8)';for(let k=0;k<N;k+=40){x.fillRect(k,254,22,3);x.fillRect(254,k,3,22)}x.fillStyle='rgba(20,22,28,.35)';for(let i=0;i<6;i++)x.fillRect(rnd()*N,rnd()*N,20+rnd()*60,20+rnd()*60)}
  for(let i=0;i<7000;i++){const v=rnd()<.5?255:0;x.fillStyle='rgba('+v+','+v+','+v+','+(.04+rnd()*.1)+')';x.fillRect(rnd()*N,rnd()*N,1+rnd()*2,1+rnd()*2)}
  return c;
}
function skyTex(top,hor,stars){
  const c=document.createElement('canvas');c.width=512;c.height=256;const x=c.getContext('2d');
  const g=x.createLinearGradient(0,0,0,256);g.addColorStop(0,top);g.addColorStop(.5,hor);g.addColorStop(1,hor);
  x.fillStyle=g;x.fillRect(0,0,512,256);
  if(stars)for(let i=0;i<260;i++){x.fillStyle='rgba(255,255,255,'+(.3+rnd()*.7)+')';x.fillRect(rnd()*512,rnd()*110,1.5,1.5)}
  return new T.CanvasTexture(c);
}
const tex=new T.CanvasTexture(groundTex('rock'));tex.wrapS=tex.wrapT=T.RepeatWrapping;tex.repeat.set(25,25);tex.anisotropy=Math.min(8,R.capabilities.getMaxAnisotropy());
const ground=new T.Mesh(new T.PlaneGeometry(1500,1500),new T.MeshStandardMaterial({map:tex,bumpMap:tex,bumpScale:2,roughness:1}));
ground.rotation.x=-Math.PI/2;ground.receiveShadow=true;sc.add(ground);
const sky=new T.Mesh(new T.SphereGeometry(800,24,14),new T.MeshBasicMaterial({side:T.BackSide,fog:false,depthWrite:false}));sky.renderOrder=-1;sc.add(sky);
const ct=document.createElement('canvas');ct.width=ct.height=128;
{const x=ct.getContext('2d');for(let i=0;i<14;i++){const px=30+rnd()*68,py=44+rnd()*40,r=18+rnd()*22;const g=x.createRadialGradient(px,py,0,px,py,r);g.addColorStop(0,'rgba(255,255,255,.55)');g.addColorStop(1,'rgba(255,255,255,0)');x.fillStyle=g;x.fillRect(0,0,128,128)}}
const cloudT=new T.CanvasTexture(ct),clouds=[];
for(let i=0;i<18;i++){const s=new T.Sprite(new T.SpriteMaterial({map:cloudT,transparent:true,opacity:.75,depthWrite:false,fog:false}));s.scale.set(160+rnd()*160,70+rnd()*40,1);s.position.set((rnd()-.5)*700,170+rnd()*70,-rnd()*900);sc.add(s);clouds.push(s)}

// ═══════════════════════════════════════════════════════════════
// МОДЕЛИ
// ═══════════════════════════════════════════════════════════════
let WALL={};
function mkShahed(){
  const g=new T.Group(),SG=new T.SphereGeometry(1,16,12);
  const sk=new T.MeshStandardMaterial({color:0xc3c8cb,metalness:.3,roughness:.55}),
        nose=new T.MeshStandardMaterial({color:0x3b3f3a,metalness:.3,roughness:.5}),
        eng=new T.MeshStandardMaterial({color:0x2a2c2e,metalness:.7,roughness:.4}),
        blade=new T.MeshStandardMaterial({color:0x111214,roughness:.6}),
        disc=new T.MeshBasicMaterial({color:0xd0d6dc,transparent:true,opacity:.13,depthWrite:false,side:T.DoubleSide});
  const Rr=[[0,3.4],[.35,2.4],[2.5,-2.5],[2.5,-3.2],[.45,-3.4]],s=new T.Shape();
  s.moveTo(Rr[0][0],Rr[0][1]);for(let i=1;i<Rr.length;i++)s.lineTo(Rr[i][0],Rr[i][1]);
  for(let i=Rr.length-1;i>0;i--)s.lineTo(-Rr[i][0],Rr[i][1]);s.closePath();
