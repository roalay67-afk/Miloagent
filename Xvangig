    </div>
    <div class="panel">
      <h2>Звук</h2>
      <label style="display:flex;align-items:center;padding:8px 0"><input type="checkbox" id="snd" ${soundEnabled?'checked':''}> Эффекты</label>
      <label style="display:flex;align-items:center;padding:8px 0"><input type="checkbox" id="mus" ${musicEnabled?'checked':''}> Музыка</label>
    </div>
    <div class="panel">
      <h2>Графика</h2>
      <label style="display:flex;align-items:center;padding:8px 0"><input type="checkbox" id="lowg" ${lowGraphics?'checked':''}> Низкое качество</label>
    </div>
    <div class="panel">
      <h2>📊 Статистика</h2>
      <div class="statrow"><span>Побед</span><b>${profile.wins}</b></div>
      <div class="statrow"><span>Поражений</span><b>${profile.losses}</b></div>
      <div class="statrow"><span>Рекорд</span><b>${profile.highest}</b></div>
      <div class="statrow"><span>Монет заработано</span><b>${profile.totalCoins}</b></div>
    </div>
    <button class="b" onclick="saveSettings()">Сохранить</button>
