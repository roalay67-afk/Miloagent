}
function saveSettings(){
  localStorage.setItem('sens',$('sens')?.value||5);
  soundEnabled=$('snd')?.checked??true;
  musicEnabled=$('mus')?.checked??false;
  lowGraphics=$('lowg')?.checked??false;
  toast('Настройки сохранены');homeScreen();
}
let lowGraphics=localStorage.getItem('lowg')==='true';
if(localStorage.getItem('sens')===null)localStorage.setItem('sens','5');

// ═══════════════════════════════════════════════════════════════
// СТАРТ ИГРЫ
// ═══════════════════════════════════════════════════════════════
function startGame(mapIdx){
  mapI=mapIdx;
  setMap(mapI);
  hideMenu();
  clearAll();
  const st=getDroneStats();
  MAX_HP=st.hp;hp=st.hp;
  SP=62+st.speed;
  level=1;
  consumables={flare:3,boost:2,repair:1};
  updateConsumableUI();
  gameStats={kills:0,samKills:0,noHit:true};
  // Сброс состояния
  jet.position.set(0,25,0);jet.rotation.set(0,0,0);
  jx=0;jy=25;vy=0;tx=0;TZ=0;
  tgt=mkTarget(rnd()*4|0);TZ=-180;tgt.g.position.set(0,0,TZ);
  sams=[];obst=[];ms=[];ints=[];
  // Стартовый SAM
  addSam((rnd()-.5)*30,TZ+40);
  S='play';
  $('js').style.display='none';
  $('hud').style.display='flex';
  updateHUD();
}
function updateHUD(){
  $('lv').textContent='Ур. '+level;
  $('dist').textContent=Math.max(0,Math.round(-jet.position.z))+' м';
  $('hp').textContent='❤'.repeat(Math.max(0,hp));
}
function gameOver(win){
  S='over';
  const reward=win?200+level*50:Math.floor(level*15);
  profile.coins+=reward;profile.totalCoins+=reward;
  if(win){profile.wins++;if(level>profile.highest)profile.highest=level;if(gameStats.noHit)profile.noHitWin=true;profile.dailyKills=(profile.dailyKills||0)+gameStats.kills;profile.dailySAM=(profile.dailySAM||0)+gameStats.samKills}
  else{profile.losses++}
  saveProfile();
  showMenu(`<div class="screen">
    <h1 class="brand">${win?'🎉 Победа!':'💥 Поражение'}</h1>
    <p class="sub">${win?`Цель уничтожена за ${level} уровней.`:'Дрон сбит.'}</p>
    <div class="panel">
      <div class="statrow"><span>Награда</span><b>+${reward}💰</b></div>
      <div class="statrow"><span>Целей уничтожено</span><b>${gameStats.kills}</b></div>
      <div class="statrow"><span>SAM уничтожено</span><b>${gameStats.samKills}</b></div>
    </div>
    <button class="b" onclick="homeScreen()">🏠 Меню</button>
    <button class="m" onclick="startGame(${mapI})">🔄 Ещё раз</button>
  </div>`);
}

// ═══════════════════════════════════════════════════════════════
// РАСХОДНИКИ
// ═══════════════════════════════════════════════════════════════
function initConsumables(){
  consumables={flare:3,boost:2,repair:1};
  updateConsumableUI();
  $('btnFlare').onclick=useFlare;
  $('btnBoost').onclick=useBoost;
  $('btnRepair').onclick=useRepair;
  addEventListener('keydown',e=>{
    if(e.key==='f'||e.key==='F')useFlare();
    if(e.key==='b'||e.key==='B')useBoost();
    if(e.key==='r'||e.key==='R')useRepair();
  });
}
function updateConsumableUI(){
  ['Flare','Boost','Repair'].forEach(k=>{
    const key=k.toLowerCase();
    const el=$('btn'+k);
    if(!el)return;
    el.querySelector('.cnt').textContent=consumables[key];
    el.classList.toggle('empty',consumables[key]<=0);
  });
}
function useFlare(){
  if(S!=='play'||consumables.flare<=0)return;
  consumables.flare--;updateConsumableUI();toast('🔥 Ловушки');
  for(let i=ms.length-1;i>=0;i--){
    if(ms[i].g.position.distanceTo(jet.position)<120){
      boom(ms[i].g.position.clone(),15);sc.remove(ms[i].g);ms.splice(i,1);
    }
  }
  sndBoom(.3);
}
function useBoost(){
  if(S!=='play'||consumables.boost<=0||boostTime>0)return;
  consumables.boost--;updateConsumableUI();boostTime=3;toast('⚡ Ускорение 3с');
}
function useRepair(){
  if(S!=='play'||consumables.repair<=0||hp>=MAX_HP)return;
  consumables.repair--;hp=Math.min(MAX_HP,hp+1);updateConsumableUI();toast('🛠 +1 HP');updateHUD();
}

// ═══════════════════════════════════════════════════════════════
// RWR / МИНИ-КАРТА / СТРЕЛКА
// ═══════════════════════════════════════════════════════════════
const minimapCtx=$('minimap').getContext('2d');
const arrowEl=$('targetArrow');
function checkRWR(dt){
  if(!ms.length){$('warn').classList.remove('show');rwrTimer=0;return}
  let closest=null,cd=1e9;
  for(const m of ms){const d=m.g.position.distanceTo(jet.position);if(d<cd){cd=d;closest=m}}
  if(closest&&cd<200){
    $('warn').classList.add('show');rwrTimer+=dt;
    if(rwrTimer>0.6){rwrTimer=0;sndRWR()}
  }else $('warn').classList.remove('show');
}
function drawMinimap(){
  const W=220,H=220;minimapCtx.clearRect(0,0,W,H);
  const range=350,cx=W/2,cy=H/2;
  minimapCtx.strokeStyle='rgba(255,255,255,.08)';minimapCtx.lineWidth=1;
  for(let i=1;i<4;i++){
    minimapCtx.beginPath();minimapCtx.moveTo(i*W/4,0);minimapCtx.lineTo(i*W/4,H);minimapCtx.stroke();
    minimapCtx.beginPath();minimapCtx.moveTo(0,i*H/4);minimapCtx.lineTo(W,i*H/4);minimapCtx.stroke();
  }
  const px=jet.position.x,pz=jet.position.z;
  const toMap=(x,z)=>[cx+(x-px)/range*(W/2),cy+(z-pz)/range*(H/2)];
  // SAM
  minimapCtx.fillStyle='#ffd23d';
  for(const s of sams){const[x,y]=toMap(s.g.position.x,s.g.position.z);if(x>0&&x<W&&y>0&&y<H){minimapCtx.beginPath();minimapCtx.arc(x,y,4,0,7);minimapCtx.fill()}}
  // Ракеты
  minimapCtx.fillStyle='#ff3d3d';
  for(const m of ms){const[x,y]=toMap(m.g.position.x,m.g.position.z);if(x>0&&x<W&&y>0&&y<H){minimapCtx.beginPath();minimapCtx.arc(x,y,2,0,7);minimapCtx.fill()}}
  // Цель
  if(tgt){
    const[x,y]=toMap(tgt.g.position.x,tgt.g.position.z);
    if(x>0&&x<W&&y>0&&y<H){
      minimapCtx.fillStyle='#3ddc84';
      minimapCtx.beginPath();minimapCtx.moveTo(x,y-6);minimapCtx.lineTo(x+6,y);minimapCtx.lineTo(x,y+6);minimapCtx.lineTo(x-6,y);minimapCtx.closePath();minimapCtx.fill();
    }else{
      const dx=tgt.g.position.x-px,dz=tgt.g.position.z-pz,ang=Math.atan2(dz,dx);
      const ex=cx+Math.cos(ang)*(W/2-12),ey=cy+Math.sin(ang)*(H/2-12);
      minimapCtx.fillStyle='#3ddc84';minimapCtx.beginPath();minimapCtx.arc(ex,ey,5,0,7);minimapCtx.fill();
    }
  }
  // Дрон
  minimapCtx.fillStyle='#fff';minimapCtx.beginPath();
  minimapCtx.moveTo(cx,cy-7);minimapCtx.lineTo(cx+5,cy+5);minimapCtx.lineTo(cx-5,cy+5);minimapCtx.closePath();minimapCtx.fill();
}
function updateTargetArrow(){
  if(!tgt){arrowEl.style.opacity=0;return}
  const v=tgt.g.position.clone().project(cam);
  const onScreen=Math.abs(v.x)<.9&&Math.abs(v.y)<.9&&v.z<1;
  if(onScreen){arrowEl.style.opacity=0;return}
  arrowEl.style.opacity=.85;
  const dx=tgt.g.position.x-jet.position.x,dz=tgt.g.position.z-jet.position.z;
  const ang=Math.atan2(dz,dx);
  const RR=Math.min(innerWidth,innerHeight)*0.38;
  const sx=innerWidth/2+Math.cos(ang)*RR,sy=innerHeight/2+Math.sin(ang)*RR;
  arrowEl.style.left=(sx-10)+'px';arrowEl.style.top=(sy-9)+'px';
  arrowEl.style.transform=`rotate(${ang+Math.PI/2}rad)`;
}

// ═══════════════════════════════════════════════════════════════
// УПРАВЛЕНИЕ
// ═══════════════════════════════════════════════════════════════
addEventListener('keydown',e=>{key[e.key.toLowerCase()]=1});
addEventListener('keyup',e=>{key[e.key.toLowerCase()]=0});
let touchStart=null;
addEventListener('touchstart',e=>{
  if(S!=='play')return;
  const t=e.touches[0];
  touchStart={x:t.clientX,y:t.clientY};
  // Тап по правой части — ракета
  if(t.clientX>innerWidth*.65){fireMissile()}
},{passive:true});
addEventListener('touchmove',e=>{
  if(S!=='play'||!touchStart)return;
  const t=e.touches[0];
  const dx=(t.clientX-touchStart.x)/innerWidth;
  const dy=(t.clientY-touchStart.y)/innerHeight;
  const sens=parseFloat(localStorage.getItem('sens')||5)/5;
  tx+=dx*sens*3;vy-=dy*sens*80;
  touchStart={x:t.clientX,y:t.clientY};
},{passive:true});
addEventListener('touchend',()=>{touchStart=null});
addEventListener('mousedown',e=>{if(S==='play'&&e.clientX>innerWidth*.65)fireMissile()});

// ═══════════════════════════════════════════════════════════════
// РАКЕТЫ ИГРОКА
// ═══════════════════════════════════════════════════════════════
let lastFire=0;
function fireMissile(){
  const now=performance.now();
  if(now-lastFire<400)return;lastFire=now;
  if(S!=='play')return;
  const m=mkPlayerMissile(jet.position.clone());
  ints.push(m);
}
function mkPlayerMissile(p){
  const g=new T.Group(),b=mesh(CYL,M(0xffd24a),.25,1.8,.25,0,0,0);b.rotation.x=Math.PI/2;
  const f=mesh(CONE,B(0xff6020),.2,.8,.2,0,0,1.2);f.rotation.x=Math.PI/2;
  g.add(b,f);g.position.copy(p);sc.add(g);
  return{g,v:new T.Vector3(0,-30,-100),life:4};
}

// ═══════════════════════════════════════════════════════════════
// РАКЕТЫ SAM
// ═══════════════════════════════════════════════════════════════
function mkMissile(p,type='normal'){
  const g=new T.Group();
  const colors={normal:0xe0e0e0,homing:0x70c0ff,swarm:0xffb070};
  const b=mesh(CYL,M(colors[type]||0xe0e0e0),.35,2.6,.35,0,0,0);b.rotation.x=Math.PI/2;
  const f=mesh(CONE,type==='homing'?B(0x40a0ff):FL,.3,1.2,.3,0,0,1.8);f.rotation.x=Math.PI/2;
  g.add(b,f);g.position.copy(p);sc.add(g);
  return{g,v:new T.Vector3(0,45,0),life:6,type,homing:type==='homing',turn:1.2,
    target:type==='homing'?jet.position.clone():null,speed:type==='homing'?38:45};
}

// ═══════════════════════════════════════════════════════════════
// ГЛАВНЫЙ ЦИКЛ
// ═══════════════════════════════════════════════════════════════
function animate(){
  requestAnimationFrame(animate);
  let now=performance.now();
  let dt=Math.min((now-last)/1000,0.05); // 🔧 фикс dt
  last=now;
  
  if(S!=='play'){
    // Меню — просто лёгкая анимация камеры
    cam.position.set(0,25,10);
    cam.lookAt(0,0,-100);
    R.render(sc,cam);
    return;
  }
  
  t+=dt;
  
  // === УПРАВЛЕНИЕ ===
  const sens=parseFloat(localStorage.getItem('sens')||5)/5;
  if(key['a']||key['arrowleft'])tx-=dt*sens*3;
  if(key['d']||key['arrowright'])tx+=dt*sens*3;
  if(key['w']||key['arrowup'])vy+=dt*sens*300;
  if(key['s']||key['arrowdown'])vy-=dt*sens*300;
  
  // === БУСТ ===
  let curSP=SP;
  if(boostTime>0){boostTime-=dt;curSP=SP*1.6}
  
  // === КРЕН ===
  rollTarget=-(tx)*0.6;
  rollCur+=(rollTarget-rollCur)*Math.min(1,dt*6);
  jet.rotation.z=rollCur;
  jet.rotation.x=Math.max(-.3,Math.min(.3,-vy*0.003));
  
  // === ДВИЖЕНИЕ ДРОНА ===
  jet.position.z-=curSP*dt;
  tx=Math.max(-7,Math.min(7,tx));
  jet.position.x=tx;
  vy=Math.max(-40,Math.min(40,vy));
  vy*=0.95;
  jet.position.y=Math.max(8,Math.min(50,jet.position.y+vy*dt));
  
  // Винт
  if(jet.userData.rot)jet.userData.rot.forEach(r=>r.rotation.z+=dt*20);
  
  // === ДЕКОРАЦИИ ===
  fillDecor();
  
  // === ОБНОВЛЕНИЕ ЦЕЛИ ===
  if(tgt){
    tgt.g.position.z=jet.position.z-TZ;
    tgt.ring.rotation.z+=dt;
    if(tgt.g.position.distanceTo(jet.position)<18){
      gameStats.kills++;
      if(tgt.kind==2){
        // Нефтебаза — цепная детонация
        boom(tgt.g.position.clone(),60);
        for(let i=0;i<4;i++)setTimeout(()=>boom(tgt.g.position.clone().add(new T.Vector3((rnd()-.5)*30,rnd()*5,(rnd()-.5)*30)),40),i*150);
      }else if(tgt.kind==3){
        // Электростанция — EMP (визуально)
        boom(tgt.g.position.clone(),80);
      }else boom(tgt.g.position.clone(),50);
      sc.remove(tgt.g);sc.remove(tgt.ring);tgt=null;
      level++;
      // Следующая цель
      setTimeout(()=>{
        if(S!=='play')return;
        tgt=mkTarget(rnd()*4|0);TZ-=180+rnd()*80;tgt.g.position.set(0,0,jet.position.z-TZ);
        // Добавляем SAM каждые 2 уровня
        if(level%2===0)addSam((rnd()-.5)*40,TZ+50);
        // Ракеты
        if(level>=3){const t=['normal','normal','homing','swarm'][rnd()*4|0];ms.push(mkMissile(sams[0]?.g.position.clone()||new T.Vector3(0,10,jet.position.z-100),t))}
      },500);
    }
  }
  
  // === ОБНОВЛЕНИЕ SAM ===
  for(const s of sams){
    s.cd-=dt;
    if(s.cd<=0&&ms.length<3){
      s.cd=1.5+rnd()*2;
      const t=level>=4?['normal','homing','swarm'][rnd()*3|0]:'normal';
      ms.push(mkMissile(s.g.position.clone().setY(s.g.position.y+4),t));
    }
  }
  
  // === РАКЕТЫ ===
  for(let i=ms.length-1;i>=0;i--){
    const m=ms[i];
    if(m.homing&&m.target){
      const dir=m.target.clone().sub(m.g.position).normalize();
      m.v.lerp(dir.multiplyScalar(m.speed),Math.min(1,dt*m.turn));
    }else{m.v.y-=dt*20}
    m.g.position.addScaledVector(m.v,dt);
    m.g.rotation.z=Math.atan2(m.v.y,-m.v.z)*0.3;
    m.life-=dt;
    if(m.g.position.distanceTo(jet.position)<5&&m.life>0){
      // Попадание
      if(inv<=0){hp--;inv=1;shk=1;sndBoom(1);
        const fl=$('fl');fl.style.opacity=.6;setTimeout(()=>fl.style.opacity=0,300);
        updateHUD();
        gameStats.noHit=false;
        if(hp<=0){boom(jet.position.clone(),50);gameOver(false);return}
      }
      boom(m.g.position.clone(),20);sc.remove(m.g.position);sc.remove(m.g);ms.splice(i,1);continue;
    }
    if(m.life<=0||m.g.position.y<0||Math.abs(m.g.position.z-jet.position.z)>300){
      sc.remove(m.g);ms.splice(i,1);
    }
  }
  
  // === РАКЕТЫ ИГРОКА ===
  for(let i=ints.length-1;i>=0;i--){
    const m=ints[i];
    m.g.position.addScaledVector(m.v,dt);
    m.life-=dt;
    // Проверка попадания в цель
    if(tgt&&m.g.position.distanceTo(tgt.g.position)<25){
      gameStats.kills++;
      boom(tgt.g.position.clone(),50);
      sc.remove(tgt.g);sc.remove(tgt.ring);tgt=null;
      level++;
      setTimeout(()=>{
        if(S!=='play')return;
        tgt=mkTarget(rnd()*4|0);TZ-=180+rnd()*80;tgt.g.position.set(0,0,jet.position.z-TZ);
        if(level%2===0)addSam((rnd()-.5)*40,TZ+50);
      },500);
      sc.remove(m.g);ints.splice(i,1);continue;
    }
    // Попадание в SAM
    let hitSam=false;
    for(const s of sams){
      if(m.g.position.distanceTo(s.g.position)<10){
        gameStats.samKills++;
        boom(s.g.position.clone(),40);
        sc.remove(s.g);sams.splice(sams.indexOf(s),1);
        sc.remove(m.g);ints.splice(i,1);hitSam=true;break;
      }
    }
    if(hitSam)continue;
    if(m.life<=0||m.g.position.y<0){sc.remove(m.g);ints.splice(i,1)}
  }
  
  // === ЧАСТИЦЫ ===
  updFX(dt);
  for(let i=parts.length-1;i>=0;i--){
    const p=parts[i];
    p.v.y-=(p.g||30)*dt;
    p.o.position.addScaledVector(p.v,dt);
    p.o.rotation.x+=dt*(p.sp||5);p.o.rotation.y+=dt*(p.sp||5);
    p.l-=dt;
    if(p.l<=0&&!p.keep){sc.remove(p.o);parts.splice(i,1)}
  }
  for(let i=fxs.length-1;i>=0;i--){
    const f=fxs[i];f.t+=dt;
    if(f.t>=f.d){sc.remove(f.o);f.m.dispose();fxs.splice(i,1);continue}
    f.o.scale.setScalar(f.s*(1+f.t/f.d*3));f.m.opacity=.8*(1-f.t/f.d);
  }
  
  // === CAM ===
  if(inv>0)inv-=dt;
  const camOff=shk;
  cam.position.set(jet.position.x*0.3+(Math.random()-.5)*camOff*3, jet.position.y+6+(Math.random()-.5)*camOff*3, jet.position.z+22);
  cam.lookAt(jet.position.x, jet.position.y+3, jet.position.z-40);
  if(shk>0)shk=Math.max(0,shk-dt*2);
  
  // Солнце
  sunS.position.copy(SD).add(jet.position);
  sun.position.copy(SD).add(jet.position);
  sun.target.position.copy(jet.position);
  
  // === HUD ===
  updateHUD();
  checkRWR(dt);
  drawMinimap();
  updateTargetArrow();
  
  R.render(sc,cam);
}

// ═══════════════════════════════════════════════════════════════
// СТАРТ
// ═══════════════════════════════════════════════════════════════
$('loading').style.display='none';
homeScreen();
animate();
</script>
